{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "overrides": [
    {
      "files": [
        "manifest.json",
        "server.json",
        ".claude-plugin/marketplace.json",
        ".release-please-manifest.json",
        "plugins/automem/.cursor-plugin/plugin.json"
      ],
      "options": {
        "parser": "json-stringify"
      }
    }
  ]
}
